PORT=3000

# Server-only. Put real values in .env.local on the server, never in the site or in git.
# Never use NEXT_PUBLIC_ for inbox addresses — they must not appear in the browser bundle.
#
# Recipients by site (preferred):
#   eladoingatlan.vrgo.hu → RECIPIENT_ELADOINGATLAN
#   vrgo.hu + bim.vrgo.hu → RECIPIENT_MAIN
RECIPIENT_ELADOINGATLAN=
RECIPIENT_MAIN=
# Legacy aliases (still read if RECIPIENT_* unset):
LISTING_INBOX_EMAIL=
QUOTE_INBOX_EMAIL=
# SMTP: From must be the authenticated mailbox (SMTP_FROM or SMTP_USER).
# Do NOT use a retired mailbox that the provider rejects.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

PORT=3000

# Server-only. Put real values in .env.local on the server, never in the site or in git.
# Never use NEXT_PUBLIC_ for inbox addresses — they must not appear in the browser bundle.
QUOTE_INBOX_EMAIL=
# Private listing enquiries (eladoingatlan.vrgo.hu). Separate from the VRGO quote inbox.
# Expected: kisspatrikpetervr@gmail.com (server also has this as code fallback).
LISTING_INBOX_EMAIL=kisspatrikpetervr@gmail.com
# Real SMTP host required (mail.domain.hu is treated as unset).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Alias accepted by the mailer if SMTP_FROM is empty:
MAIL_FROM=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

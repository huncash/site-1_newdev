PORT=3000

# Server-only. Put real values in .env.local on the server, never in the site or in git.
# Never use NEXT_PUBLIC_ for inbox addresses — they must not appear in the browser bundle.
#
# vrgo.hu + bim.vrgo.hu forms → RECIPIENT_MAIN
RECIPIENT_MAIN=
# Legacy alias (still read if RECIPIENT_MAIN unset):
QUOTE_INBOX_EMAIL=
# SMTP: From must be the authenticated mailbox (SMTP_FROM or SMTP_USER).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

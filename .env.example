PORT=3000

# Server-only. Put real values in .env.local on the server, never in the site or in git.
# Never use NEXT_PUBLIC_ for inbox addresses — they must not appear in the browser bundle.
# VRGO + BIM forms → QUOTE_INBOX_EMAIL (default in code: adptopkft@gmail.com if unset)
QUOTE_INBOX_EMAIL=
# eladoingatlan.vrgo.hu forms → LISTING_INBOX_EMAIL (default in code: kisspatrikpetervr@gmail.com if unset)
LISTING_INBOX_EMAIL=
# SMTP: From must be the authenticated mailbox (do NOT use info@vrgo.hu — retired / rejected).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
